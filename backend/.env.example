# ===================================================================
# Smart Accident Detection - Cloud Backend Environment Configuration
# ===================================================================

# Server Port (Render sets this automatically via process.env.PORT)
PORT=3000

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Keep strictly server-side! Never put in Android or ESP32)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
